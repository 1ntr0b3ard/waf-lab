# Copy to .env and adjust for the machine you deploy on:
#   cp .env.example .env
#
# Docker Compose reads .env automatically from this directory,
# and check.sh sources it too.

# Where the ports are published.
#   127.0.0.1  = local machine only (recommended; the lab is deliberately vulnerable)
#   0.0.0.0    = all interfaces (LAN-accessible -- use only on an isolated lab network)
#   <LAN IP>   = single interface
LAB_BIND=127.0.0.1

# Host that check.sh uses for test requests (normally localhost)
LAB_HOST=127.0.0.1

# Host ports. Change these if crAPI or anything else already uses 8080-8085.
# Example for a crAPI host: use 9080-9085.
DVWA_PORT=8080
WAF_PORT=8081
ECHO_PORT=8082
WAF_ECHO_PORT=8083
WEAK_PORT=8084
WEAK_ECHO_PORT=8085
